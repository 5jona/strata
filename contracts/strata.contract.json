        { "name": "container", "type": "string" },
        { "name": "previous", "type": { "ref": "ContainerPhase" } },
        { "name": "current", "type": { "ref": "ContainerPhase" } },
        { "name": "snapshot", "type": { "ref": "ContainerStatusSnapshot" } }
