        { "name": "drained_pids", "type": "usize" },
        { "name": "unmounted_paths", "type": "usize" },
        { "name": "detached_loops", "type": "usize" },
        { "name": "residual_mounts", "type": "usize" },
        { "name": "residual_loops", "type": "usize" }
      ]
    },
