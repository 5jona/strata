    },
    "ContainerLogsParams": {
      "doc": "Parameters for container.logs.",
      "renameAll": "camelCase",
      "rustDerives": ["Debug", "Clone", "Default", "PartialEq", "Eq", "Serialize", "Deserialize"],
      "fields": [
        { "name": "container", "type": "string", "optional": true },
        { "name": "lines", "type": "usize", "optional": true }
      ]
    },
    "ContainerLogsResult": {
      "doc": "Result for container.logs.",
      "renameAll": "camelCase",
      "rustDerives": ["Debug", "Clone", "PartialEq", "Eq", "Serialize", "Deserialize"],
      "fields": [
        { "name": "container", "type": "string" },
        { "name": "log_path", "type": "string" },
