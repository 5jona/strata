{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minHostVersion": "0.1.0",
  "id": "strata.manager",
  "name": "Strata 容器",
  "version": "0.2.0",
  "description": "Android Linux 容器快捷控制、托管服务与 PC 配对侧边栏",
  "icon": "web/icon.svg",
  "defaultEnabled": true,
  "triggers": {
    "packages": [],
    "activities": [],
    "global": true,
    "priority": 30
  },
  "entry": "web/index.html",
  "backend": "uds-native",
  "capabilities": ["toast", "clipboard", "haptics", "native-hud"],
  "surface": {
    "backdrop": "native-glass",
    "presentation": "drawer",
    "crossOriginIsolated": false,
    "widthDp": 344,
    "heightPercent": 68
  }
}
